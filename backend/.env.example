# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string
# Atlas dashboard -> Connect -> Drivers -> copy the string, then replace
# <password> and add the database name before the "?" (e.g. /ecommerce?)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# Any long random string — used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# development | production
NODE_ENV=development

# Port the API listens on (Render sets this automatically in production —
# the code already falls back to it, this is only for local runs)
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default: http://localhost:5173
# Production: your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# From your PayPal developer dashboard (sandbox app for testing)
PAYPAL_CLIENT_ID=
